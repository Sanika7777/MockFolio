# Required. Railway provides this as a service variable; use a local MySQL URL for development.
DATABASE_URL=mysql+pymysql://mf_app:your_password@127.0.0.1:3306/mockfolio
# Required. Generate a unique value; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-development-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mockfolio
TEST_DB_NAME=mockfolio_test
DB_MIGRATE_USER=mf_migrate
DB_MIGRATE_PASS=your_migrate_password

DEV_USERNAME=developer
DEV_EMAIL=developer@mockfolio.local
DEV_PASSWORD=change-this-local-password

LOG_LEVEL=INFO
TX_ISOLATION=REPEATABLE READ
LOCK_WAIT_TIMEOUT=5

MARKET_DATA_SOURCE=simulated
ENABLE_TICK_WORKER=1

# Only needed when MARKET_DATA_SOURCE=angelone. Market data permissions only,
# never order placement. ANGEL_TOTP_SECRET is as sensitive as a password.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Only needed to run pytest tests/concurrency and scripts/*.py. Must be a
# separate, disposable database: those tests truncate tables.
TEST_DATABASE_URL=

# Leave empty when the API serves the frontend (same origin, the default).
# For the standalone frontend dev server, set this to http://127.0.0.1:5500.
CORS_ORIGINS=
